# i3status configuration file.
# see "man i3status" for documentation.
#
#
# Specifies an alternate configuration file path.
# By default, i3status looks for configuration files in the following order:
#       1) ~/.config/i3status/config (or $XDG_CONFIG_HOME/i3status/config if set)
#       2) /etc/xdg/i3status/config (or $XDG_CONFIG_DIRS/i3status/config if set)
#       3) ~/.i3status.conf
#       4) /etc/i3status.conf
#
# Updates:
# 2021-10-02: To see icons in this file correctly, both FontAwesome 4.7 and
# 5.15.4 have been installed. The former was installed using apt package
# manager ($ sudo apt install fonts-font-awesome), and the later was
# downloaded from the website and installed manually using fc-cache command.
#
# ============================================================================
# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!
#
#
# To find a comprehensive lists of available unicode characters, see:
# http://jrgraphix.net/r/Unicode/E000-F8FF   # does not work any more (14-07-2022)
# https://fontawesome.com/search?s=solid%2Cbrands
#
#
# You can enetr unicode characters in vim as follows (^V means Ctrl-V):
#
#- By decimal value: ^Vnnn (with 000 <= nnn <= 255)
#- By octal value: ^VOnnn or ^Vonnn (with 000 <= nnn <= 377)
#- By hex value: ^VXnn or ^Vxnn (with 00 <= nn <= FF)
#- By hex value for BMP Unicode codepoints: ^Vunnnn (with 0000 <= nnnn <= FFFF)
#- By hex value for any Unicode codepoint: ^VUnnnnnnnn (with 00000000 <= nnnnnnnn <= 7FFFFFFF)
#
# For more information see: http://vim.wikia.com/wiki/Entering_special_characters)
# NOTE: Above commands are done in INSERT mode in vim.
# NOTE: If you use Ctrl-V to paste, you should hit Ctrl-Q instead
# ============================================================================

general {
        colors = true
        interval = 5
        color_bad = "#ff4077"
        color_good = "#00bf88"
}

order += "ipv6"
order += "run_watch DHCP"
order += "run_watch VPN"
order += "wireless _first_"
order += "ethernet _first_"
order += "volume master"
order += "disk /"
order += "cpu_temperature 0"
order += "cpu_usage 0"
order += "load"
order += "battery all"
# order += "tztime local"
# order += "tztime dublin"
order += "tztime date"
order += "tztime time"


wireless _first_ {
        # nf-fa-wifi: f1eb
        format_up = "  %quality %essid "
        format_down = "  down "
}

ethernet _first_ {
        # if you use %speed, i3status requires root privileges
        # nf-fa-ethernet: ef44
        format_up = "  %ip (%speed) "
        format_down = "  down "
}

battery all {
        format = " %status %percentage %remaining "
        format_down = "No Battery"
        last_full_capacity = true
        integer_battery_capacity = true
        low_threshold = 30
        threshold_type = time
        hide_seconds = true
        # nf-md-battery_charging: f0084
        status_chr = "󰂄 C"
        # nf-md-battery_medium: f12a2
        status_bat = "󱊢 B"
	# nf-cod-plug: eb2d
        status_unk = " U"
        # nf-md-battery_high: f12a3
        status_full = "󱊣 F"
}

#battery all {
#        format = "%status %percentage %remaining"
#}

run_watch DHCP {
        pidfile = "/var/run/dhclient*.pid"
}

run_watch VPN {
        pidfile = " /var/run/vpnc/pid "
}

tztime local {
        format = "  %a, %d %b %Y  %H:%M:%S %Z "
}

tztime dublin {
        format = "  %time "
        format_time = "%H:%M:%S %Z"
        timezone = "Europe/Dublin"
        hide_if_equals_localtime = false
}

tztime date {
        # nf-cod-calendar: eab0
        format = "  %a, %d %b %Y "
}

tztime time {
	# nf-fa-clock: f017
        format = "  %H:%M:%S %Z "
}

load {
        # nf-fa-truck_monster: eeb8
        format = "   %1min "
}

cpu_usage {
        # nf-oct-cpu: f4bc
        format = "   %usage "
}

cpu_temperature 0 {
        # nf-fa_temperature_half: f2c9; nf-md_temperature_celsius: f0504
        format = "  %degrees󰔄 "
}

disk "/" {
        format = "  %free "   # nf-fa-hard_drive: f0a0
        prefix_type = " binary "
}

volume master {
        # Volume-up: f028
        format = "   %volume "
        # Volume-off: f026
        format_muted = "  %volume "
        # To obtain the name of the PulseAudio sink, use the following command:
        # $ pacmd list-sinks | grep name:
        #   name: <alsa_output.pci-0000_00_1f.3.analog-stereo>
        # Then, we can set the device line as following:
        #   device = "pulse:alsa_output.pci-0000_00_1f.3.analog-stereo"
        # If the device string is set to "default", PulseAudio will be tried if
        # detected and will fallback to ALSA (Linux).
        device = "default"
}
