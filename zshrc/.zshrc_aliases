alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

#
# Some more ls aliases
#
alias ls="ls --group-directories-first --color=auto"
alias l1="ls -1F"

#
# Gnome input-output aliases
#
alias rename='gio rename'

#
# Customised command to open files
#
custom_open () { gio open "$@" > /dev/null 2>&1 & }
alias open='custom_open'
